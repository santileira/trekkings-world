# Sanity CMS Configuration
# Create a project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Google Analytics 4
# Create a property at https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sanity API Token (for write operations - scripts)
# Get from: https://www.sanity.io/manage/project/YOUR_PROJECT_ID/api#tokens
SANITY_API_TOKEN=your-sanity-api-token

# Unsplash API (for fetching trek images)
# Get from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Google AdSense (after approval)
# Set ENABLED to 'true' when your site is approved
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
# Ad slot IDs (create in AdSense dashboard)
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=XXXXXXXXXX

# Giscus Comments (after setup at https://giscus.app)
# NEXT_PUBLIC_GISCUS_REPO=username/trekkings-world
# NEXT_PUBLIC_GISCUS_REPO_ID=your-repo-id
# NEXT_PUBLIC_GISCUS_CATEGORY=Comments
# NEXT_PUBLIC_GISCUS_CATEGORY_ID=your-category-id

# ============================================
# Social Media Automation
# ============================================

# Sanity Write Token (for saving publications)
# Get from: https://www.sanity.io/manage/project/YOUR_PROJECT_ID/api#tokens
SANITY_API_WRITE_TOKEN=your-write-token

# Bluesky (recommended - free and easy to setup)
# 1. Create account at https://bsky.app
# 2. Go to Settings > App Passwords > Create
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=your-app-password

# Twitter/X (optional - requires Developer account)
# Get from: https://developer.twitter.com
# TWITTER_API_KEY=your-api-key
# TWITTER_API_SECRET=your-api-secret
# TWITTER_ACCESS_TOKEN=your-access-token
# TWITTER_ACCESS_SECRET=your-access-secret

# Instagram (optional - requires Business Account)
# 1. Convert Instagram to Business/Creator
# 2. Create Facebook Page and link
# 3. Create app at https://developers.facebook.com
# INSTAGRAM_BUSINESS_ACCOUNT_ID=your-account-id
# INSTAGRAM_ACCESS_TOKEN=your-access-token

# Claude AI (for content generation)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# Cron Security (generate a random string)
CRON_SECRET=your-random-secret-string

# Dry Run Mode (set to 'true' to test without posting)
# SOCIAL_DRY_RUN=true
