# Sanity CMS Configuration
# Create a project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Google Analytics 4
# Create a property at https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense (after approval)
# Set ENABLED to 'true' when your site is approved
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
# Ad slot IDs (create in AdSense dashboard)
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=XXXXXXXXXX

# Giscus Comments (after setup at https://giscus.app)
# NEXT_PUBLIC_GISCUS_REPO=username/trekkings-world
# NEXT_PUBLIC_GISCUS_REPO_ID=your-repo-id
# NEXT_PUBLIC_GISCUS_CATEGORY=Comments
# NEXT_PUBLIC_GISCUS_CATEGORY_ID=your-category-id
